{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/css/variables.css", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{variables.css,public/index.html}"
    }
  }
}
